}

params:query {
  action: setConfig
  Encode[0].MainFormat[0].Audio.Compression: G.711A
  Encode[0].MainFormat[0].Audio.Frequency: 8000
}

auth:basic {
  username: admin
  password: admin@123
}

settings {
  encodeUrl: true
}
