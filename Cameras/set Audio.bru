meta {
  name: set Audio
  type: http
  seq: 5
}

get {
  url: http://10.1.4.4/cgi-bin/configManager.cgi?action=setConfig&Encode[0].MainFormat[0].Audio.Compression=G.711A&Encode[0].MainFormat[0].Audio.Frequency=8000
  body: none
