meta {
  name: AddServices
  type: http
  seq: 3
}

post {
  url: http://{{NodeHost}}:{{NodePort}}/keus/v1/node_configuration/AddServices
  body: json
  auth: inherit
}

body:json {
  {
      "services": [{
          "id": "site_manager",
          "serviceType": "INTRA_PROCESS",
          "instanceCount": 1
      }]
  }
  
