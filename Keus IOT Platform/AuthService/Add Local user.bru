meta {
  name: Add Local user
  type: http
  seq: 1
}

post {
  url: http://{{NodeHost}}:{{NodePort}}/keus/v1/auth_service/AddLocalUser
  body: json
  auth: inherit
}

body:json {
  {
      "user": {
          "username" : "tablet",
          "password": "abcd"
      }
  }
}

settings {
  encodeUrl: true
}
