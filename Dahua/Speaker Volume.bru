meta {
  name: Speaker Volume
  type: http
  seq: 16
}

get {
  url: https://10.1.4.4/cgi-bin/configManager.cgi?action=setConfig&AudioOutputVolume[0]=100
  body: none
  auth: digest
}

params:query {
  action: setConfig
  AudioOutputVolume[0]: 100
}

headers {
  ~Content-Type: Audio/G.711A
  ~Content-Length: 999999
  ~User-Agent: client/1.0
}

auth:digest {
  username: admin
  password: admin@123
}

settings {
  encodeUrl: true
}
