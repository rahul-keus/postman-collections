meta {
  name: Microphone Volume
  type: http
  seq: 17
}

get {
  url: http://10.1.4.2/cgi-bin/configManager.cgi?action=setConfig&AudioInputVolume[0]=70
  body: none
  auth: digest
}

params:query {
  action: setConfig
  AudioInputVolume[0]: 70
}

